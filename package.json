{
  "name": "my-editor-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:editor": "cd packages/rich-text-editor && npm run dev",
    "build:editor": "cd packages/rich-text-editor && npm run build",
    "install:all": "npm install && npm run install:editor",
    "install:editor": "cd packages/rich-text-editor && npm install"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/ollama": "^0.2.0",
    "@my-editor/rich-text-editor": "workspace:*",
    "@tailwindcss/typography": "^0.5.16",
    "@vitejs/plugin-legacy": "^6.1.1",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-vue": "^5.2.0",
    "core-js": "^3.45.1",
    "tailwindcss": "^4.1.13",
    "terser": "^5.44.0",
    "vite": "^6.0.0"
  }
}
